# ---- Front end (safe to expose, prefixed VITE_) ----
# Which brand direction ships: underground | fog | nightbus
VITE_BRAND=fog
# Show the little A/B/C brand switcher in the corner (turn off for launch)
VITE_SHOW_BRAND_SWITCHER=false
# mock = fake success locally, no emails sent. api = POST to /api/subscribe
VITE_WAITLIST_MODE=mock

# ---- Server only (set these in Vercel > Settings > Environment Variables) ----
# Kit (kit.com) API v4 key: Kit > Settings > Developer > API keys
KIT_API_KEY=
# The numeric ID of your Kit form (from the form's URL in Kit)
KIT_FORM_ID=
